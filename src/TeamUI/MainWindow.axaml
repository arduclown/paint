<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GraphicEditor.ViewModels"
        x:Class="GraphicEditor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Title="Графический редактор"
        Width="1200" Height="750"
        MinWidth="900" MinHeight="600">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <Border DockPanel.Dock="Top"
                Background="#2D2D30"
                Padding="8,6">
            <StackPanel Orientation="Horizontal" Spacing="4">

                <TextBlock Text="Инструменты"
                           Foreground="#777" FontSize="9"
                           VerticalAlignment="Center" Margin="0,0,4,0" />

                <ToggleButton Content="↖ Выбор"
                              IsChecked="{Binding IsSelectTool}"
                              ToolTip.Tip="Инструмент выделения (S)"
                              Classes="toolBtn" MinWidth="68" />
                <ToggleButton Content="● Круг"
                              IsChecked="{Binding IsCircleTool}"
                              ToolTip.Tip="Нарисовать круг (C)"
                              Classes="toolBtn" MinWidth="68" />
                <ToggleButton Content="▬ Прямоуг."
                              IsChecked="{Binding IsRectangleTool}"
                              ToolTip.Tip="Нарисовать прямоугольник (R)"
                              Classes="toolBtn" MinWidth="68" />
                <ToggleButton Content="▲ Треуг."
                              IsChecked="{Binding IsTriangleTool}"
                              ToolTip.Tip="Нарисовать треугольник (T)"
                              Classes="toolBtn" MinWidth="68" />
                <ToggleButton Content="╱ Линия"
                              IsChecked="{Binding IsLineTool}"
                              ToolTip.Tip="Нарисовать линию (L)"
                              Classes="toolBtn" MinWidth="68" />

                <Separator Width="1" Height="28" Background="#555" Margin="4,0" />

                <TextBlock Text="Правка"
                           Foreground="#777" FontSize="9"
                           VerticalAlignment="Center" Margin="0,0,4,0" />

                <Button Content="↩ Отмена"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndo}"
                        ToolTip.Tip="Отменить (Ctrl+Z)"
                        Classes="actionBtn" />
                <Button Content="↪ Повтор"
                        Command="{Binding RedoCommand}"
                        IsEnabled="{Binding CanRedo}"
                        ToolTip.Tip="Повторить (Ctrl+Y)"
                        Classes="actionBtn" />

                <Separator Width="1" Height="28" Background="#555" Margin="4,0" />

                <TextBlock Text="Файл"
                           Foreground="#777" FontSize="9"
                           VerticalAlignment="Center" Margin="0,0,4,0" />

                <Button Content="Открыть…"
                        Click="ImportButton_Click"
                        ToolTip.Tip="Импортировать сцену из JSON (Ctrl+O)"
                        Classes="actionBtn" />
                <Button Content="Сохранить…"
                        Click="ExportButton_Click"
                        ToolTip.Tip="Экспортировать в SVG, PDF или JSON (Ctrl+S)"
                        Classes="actionBtn" />

                <Separator Width="1" Height="28" Background="#555" Margin="4,0" />

                <Button Content="Очистить"
                        Command="{Binding ClearAllCommand}"
                        ToolTip.Tip="Удалить все фигуры"
                        Classes="actionBtn" />

                <Separator Width="1" Height="28" Background="#555" Margin="4,0" />

                <ToggleButton Content="Сетка"
                              IsChecked="{Binding SnapEnabled, Mode=TwoWay}"
                              ToolTip.Tip="Привязка к сетке"
                              Classes="toolBtn" />

                <ComboBox x:Name="GridStepCombo"
                          Width="60" Height="28"
                          SelectedIndex="2"
                          SelectionChanged="GridStepCombo_SelectionChanged"
                          ToolTip.Tip="Шаг сетки (px)">
                    <ComboBoxItem Content="10" />
                    <ComboBoxItem Content="20" />
                    <ComboBoxItem Content="40" />
                    <ComboBoxItem Content="80" />
                </ComboBox>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="#007ACC"
                Padding="10,4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusTool, StringFormat='Инструмент: {0}'}"
                           Foreground="White" FontSize="12"
                           Margin="0,0,20,0" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusMouse}"
                           Foreground="White" FontSize="12"
                           Margin="0,0,20,0" />
                <TextBlock Grid.Column="2"
                           Text="{Binding StatusInfo}"
                           Foreground="White" FontSize="12"
                           Margin="0,0,20,0" />
                <TextBlock Grid.Column="3" />
                <TextBlock Grid.Column="4"
                           Text="{Binding StatusZoom}"
                           Foreground="White" FontSize="12"
                           Margin="0,0,20,0" />
                <TextBlock Grid.Column="5"
                           Text="{Binding StatusCanvasSize}"
                           Foreground="White" FontSize="12" />
            </Grid>
        </Border>

        <Grid ColumnDefinitions="185,*,230">

            <Border Grid.Column="0"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="0,0,1,0">
                <Grid RowDefinitions="*,Auto,220">

                    <Canvas x:Name="DragDropCanvas"
                            Grid.Row="0"
                            IsHitTestVisible="False"
                            IsVisible="False"
                            ZIndex="10" />

                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="ФИГУРЫ"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="10,10,10,6" />

                        <ListBox x:Name="ShapesListBox"
                                 ItemsSource="{Binding Shapes}"
                                 SelectedItem="{Binding SelectedShape}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="4,0,4,4"
                                 KeyboardNavigation.TabNavigation="None">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShapeViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="2,3">
                                        <Border Tag="draghandle"
                                                Background="Transparent"
                                                Padding="3,0,4,0"
                                                VerticalAlignment="Stretch"
                                                Cursor="SizeNorthSouth"
                                                ToolTip.Tip="Тянуть для изменения порядка">
                                            <TextBlock Text="⠿"
                                                       Foreground="#555"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False" />
                                        </Border>
                                        <Border Width="12" Height="12"
                                                CornerRadius="2"
                                                BorderThickness="1">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding FillColor}" />
                                            </Border.Background>
                                            <Border.BorderBrush>
                                                <SolidColorBrush Color="{Binding StrokeColor}" />
                                            </Border.BorderBrush>
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#D4D4D4"
                                                   VerticalAlignment="Center"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding LayerName}"
                                                   Foreground="#666"
                                                   VerticalAlignment="Center"
                                                   FontSize="10" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="6,4,6,2" Spacing="4">
                        <Separator Background="#3F3F46" Height="1" />
                        <TextBlock Text="СЛОИ"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="4,2,4,0" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="+ Слой"
                                    Command="{Binding AddLayerCommand}"
                                    Classes="actionBtn"
                                    Padding="6,3"
                                    FontSize="11" />
                            <Button Content="Удалить"
                                    Command="{Binding DeleteLayerCommand}"
                                    Classes="actionBtn"
                                    Padding="6,3"
                                    FontSize="11" />
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LayerViewModel">
                                    <Border BorderBrush="#3F3F46" BorderThickness="0,0,0,1">
                                        <Expander IsExpanded="True" Padding="0,0,0,2">
                                            <Expander.Header>
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                                    <ToggleButton IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                                  Content="V"
                                                                  Width="22" Height="18"
                                                                  Padding="0" FontSize="10"
                                                                  ToolTip.Tip="Показать/скрыть слой" />
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               VerticalAlignment="Center"
                                                               Cursor="Hand"
                                                               Classes.activeLayerText="{Binding IsActive}"
                                                               PointerPressed="LayerName_PointerPressed" />
                                                </StackPanel>
                                            </Expander.Header>
                                            <ItemsControl ItemsSource="{Binding Shapes}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ShapeViewModel">
                                                        <Border Padding="20,2,4,2"
                                                                Cursor="Hand"
                                                                Classes="layerShapeRow"
                                                                Classes.layerSelected="{Binding IsSelected}"
                                                                PointerPressed="LayerShape_PointerPressed">
                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                <Border Width="9" Height="9"
                                                                        CornerRadius="2"
                                                                        BorderThickness="1">
                                                                    <Border.Background>
                                                                        <SolidColorBrush Color="{Binding FillColor}" />
                                                                    </Border.Background>
                                                                    <Border.BorderBrush>
                                                                        <SolidColorBrush Color="{Binding StrokeColor}" />
                                                                    </Border.BorderBrush>
                                                                </Border>
                                                                <TextBlock Text="{Binding Name}"
                                                                           Foreground="#BBBBBB"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#1E1E1E">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                  <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomFactor}"
                                        ScaleY="{Binding ZoomFactor}" />
                    </LayoutTransformControl.LayoutTransform>
                    <Canvas x:Name="DrawingCanvas"
                            Width="1600" Height="1200"
                            Background="White"
                            Focusable="True"
                            ClipToBounds="True"
                            PointerPressed="Canvas_PointerPressed"
                            PointerMoved="Canvas_PointerMoved"
                            PointerReleased="Canvas_PointerReleased"
                            PointerWheelChanged="Canvas_PointerWheelChanged">

                        <Canvas x:Name="GridCanvas" IsHitTestVisible="False" />

                        <ItemsControl ItemsSource="{Binding Shapes}"
                                      Canvas.Left="0" Canvas.Top="0"
                                      Width="1600" Height="1200"
                                      IsHitTestVisible="True">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ShapeViewModel">
                                    <Path Data="{Binding GeometryData}"
                                          StrokeThickness="{Binding StrokeThickness}"
                                          IsVisible="{Binding IsVisible}"
                                          Opacity="{Binding Opacity}"
                                          IsHitTestVisible="True"
                                          PointerPressed="Shape_PointerPressed">
                                        <Path.Fill>
                                            <SolidColorBrush Color="{Binding FillColor}" />
                                        </Path.Fill>
                                        <Path.Stroke>
                                            <SolidColorBrush Color="{Binding StrokeColor}" />
                                        </Path.Stroke>
                                    </Path>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Path x:Name="PreviewPath"
                              IsVisible="False"
                              IsHitTestVisible="False"
                              Stroke="#FF4444"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              Canvas.Left="0" Canvas.Top="0" />

                        <Rectangle x:Name="SelectionRect"
                                   IsVisible="False"
                                   IsHitTestVisible="False"
                                   Stroke="#569CD6"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3"
                                   Fill="Transparent" />

                        <Canvas x:Name="HandlesCanvas"
                                IsHitTestVisible="True"
                                Canvas.Left="0" Canvas.Top="0" />

                    </Canvas>
                  </LayoutTransformControl>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Background="#252526"
                    BorderBrush="#3F3F46"
                    BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" Spacing="10">

                        <TextBlock Text="СВОЙСТВА"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="0,4,0,0" />

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="4">
                            <TextBlock Text="Имя:" Foreground="#D4D4D4" FontSize="12" />
                            <TextBox x:Name="ShapeNameBox"
                                     Background="#3C3C3C"
                                     Foreground="White"
                                     BorderBrush="#555"
                                     FontSize="13"
                                     TextChanged="ShapeNameBox_TextChanged" />
                            <TextBlock Text="Слой:" Foreground="#D4D4D4" FontSize="12" />
                            <ComboBox x:Name="LayerComboBox"
                                      ItemsSource="{Binding Layers}"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="LayerComboBox_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LayerViewModel">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <Separator Background="#3F3F46" Height="1" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,2">
                            <TextBlock Text="Заливка:" Foreground="#999" FontSize="11"
                                       VerticalAlignment="Center" />
                            <Border Width="22" Height="22" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="#888">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding ActiveFillColor}" />
                                </Border.Background>
                            </Border>
                            <TextBlock Text="Обводка:" Foreground="#999" FontSize="11"
                                       VerticalAlignment="Center" Margin="6,0,0,0" />
                            <Border Width="22" Height="22" CornerRadius="3"
                                    BorderThickness="1" BorderBrush="#888">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding ActiveStrokeColor}" />
                                </Border.Background>
                            </Border>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Цвет заливки:" Foreground="#D4D4D4" FontSize="12" />
                            <WrapPanel x:Name="FillColorPanel" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Цвет обводки:" Foreground="#D4D4D4" FontSize="12" />
                            <WrapPanel x:Name="StrokeColorPanel" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Недавние:" Foreground="#888" FontSize="10" />
                            <WrapPanel x:Name="RecentColorsPanel" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="4">
                            <TextBlock Text="Прозрачность:" Foreground="#D4D4D4" FontSize="12" />
                            <Slider Minimum="0.1" Maximum="1.0"
                                    Value="{Binding SelectedOpacity, Mode=TwoWay}"
                                    TickFrequency="0.1" />
                        </StackPanel>

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="4">
                            <TextBlock Text="Толщина обводки:" Foreground="#D4D4D4" FontSize="12" />
                            <Slider Minimum="0.5" Maximum="10.0"
                                    Value="{Binding SelectedStrokeWidth, Mode=TwoWay}"
                                    TickFrequency="0.5" />
                        </StackPanel>

                        <Separator Background="#3F3F46" Height="1" />

                        <StackPanel IsVisible="{Binding HasSelection}" Spacing="6">

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedShape.Bounds.X, StringFormat='X: {0:F0}'}"
                                           Foreground="#888" FontSize="11" />
                                <TextBlock Text="{Binding SelectedShape.Bounds.Y, StringFormat='Y: {0:F0}'}"
                                           Foreground="#888" FontSize="11" />
                                <TextBlock Text="{Binding SelectedShape.RotationAngle, StringFormat='Угол: {0:F1}°'}"
                                           Foreground="#888" FontSize="11" />
                            </StackPanel>

                            <TextBlock Text="Поворот:" Foreground="#D4D4D4" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBox Watermark="Угол°"
                                         Width="70"
                                         Text="{Binding AngleInput, Mode=TwoWay}"
                                         Background="#3C3C3C" Foreground="White"
                                         BorderBrush="#555" FontSize="11"
                                         KeyDown="AngleBox_KeyDown" />
                                <Button Content="OK"
                                        Command="{Binding ApplyAngleCommand}"
                                        Classes="transformBtn"
                                        Padding="6,3" />
                            </StackPanel>

                            <TextBlock Text="Масштаб:" Foreground="#D4D4D4" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="0.5x" Command="{Binding ScaleHalfCommand}" Classes="transformBtn" Padding="6,3" />
                                <Button Content="2x" Command="{Binding ScaleDoubleCommand}" Classes="transformBtn" Padding="6,3" />
                            </StackPanel>

                            <TextBlock Text="Отражение:" Foreground="#D4D4D4" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="по X" Command="{Binding MirrorXCommand}" Classes="transformBtn" />
                                <Button Content="по Y" Command="{Binding MirrorYCommand}" Classes="transformBtn" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="#3F3F46" Height="1" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Булевы операции:"
                                       Foreground="#D4D4D4" FontSize="12" />
                            <TextBlock Text="Ctrl+клик — выбрать вторую фигуру"
                                       Foreground="#666" FontSize="10"
                                       TextWrapping="Wrap" />
                            <TextBlock IsVisible="{Binding HasBothSelected}"
                                       Text="{Binding SecondSelectedShape.Name, StringFormat='+ {0}'}"
                                       Foreground="#569CD6" FontSize="11" />
                            <WrapPanel IsVisible="{Binding HasBothSelected}">
                                <Button Content="Объединить"
                                        Command="{Binding CombineUnionCommand}"
                                        Classes="transformBtn"
                                        ToolTip.Tip="Объединение (Union)"
                                        Padding="4,3" Margin="1" />
                                <Button Content="Вычесть"
                                        Command="{Binding CombineExcludeCommand}"
                                        Classes="transformBtn"
                                        ToolTip.Tip="Вычитание (Exclude): первая минус вторая"
                                        Padding="4,3" Margin="1" />
                                <Button Content="Пересечь"
                                        Command="{Binding CombineIntersectCommand}"
                                        Classes="transformBtn"
                                        ToolTip.Tip="Пересечение (Intersect)"
                                        Padding="4,3" Margin="1" />
                            </WrapPanel>
                        </StackPanel>

                        <Separator Background="#3F3F46" Height="1" />

                        <Button Content="Удалить фигуру"
                                Command="{Binding DeleteCommand}"
                                IsVisible="{Binding HasSelection}"
                                HorizontalAlignment="Stretch"
                                Classes="deleteBtn" />

                        <Separator Background="#3F3F46" Height="1" />

                        <TextBlock IsVisible="{Binding !HasSelection}"
                                   Text="Нажмите на фигуру&#10;для её выбора"
                                   Foreground="#666"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </DockPanel>

    <Window.Styles>

        <Style Selector="ToggleButton.toolBtn">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="ToggleButton.toolBtn:checked">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0098FF" />
        </Style>
        <Style Selector="ToggleButton.toolBtn:pointerover">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.actionBtn">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.actionBtn:pointerover">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>
        <Style Selector="Button.actionBtn:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.transformBtn">
            <Setter Property="Background" Value="#3C3C3C" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.transformBtn:pointerover">
            <Setter Property="Background" Value="#4C4C4C" />
        </Style>

        <Style Selector="Button.deleteBtn">
            <Setter Property="Background" Value="#6B1A1A" />
            <Setter Property="Foreground" Value="#FF9999" />
            <Setter Property="BorderBrush" Value="#922" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Button.deleteBtn:pointerover">
            <Setter Property="Background" Value="#8B2222" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="#094771" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>

        <Style Selector="Border.layerShapeRow">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.layerShapeRow:pointerover">
            <Setter Property="Background" Value="#2D2D30" />
        </Style>
        <Style Selector="Border.layerShapeRow.layerSelected">
            <Setter Property="Background" Value="#094771" />
        </Style>

        <Style Selector="TextBlock.activeLayerText">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </Window.Styles>

</Window>